# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# configuração e documentação de assistentes de IA — específicas da máquina,
# instaladas por ferramentas (ex.: `prisma init`). Não fazem parte do projeto.
# (comandos customizados em .claude/commands/ são versionados, o resto não)
.claude/*
!.claude/commands/
.agents/
.windsurf/
skills-lock.json

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
