{
  "name": "eficaz-gestao",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma migrate deploy && next build --webpack",
    "build:app": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.config.integration.mts",
    "qa:multitenant:seed": "tsx scripts/qa-multitenant-seed.mts",
    "qa:multitenant:cleanup": "tsx scripts/qa-multitenant-cleanup.mts",
    "seed:demo": "tsx scripts/seed-demo.mts",
    "limpar:demo": "tsx scripts/limpar-dados-demo.mts",
    "limpar:sessoes": "tsx scripts/limpar-sessoes-expiradas.mts",
    "corrigir:promocao-zerada": "tsx scripts/corrigir-promocao-zerada.mts",
    "whatsapp:set-integration": "tsx scripts/whatsapp-set-integration.mts",
    "check:repo": "tsx scripts/check-repo-status.mts",
    "scan:secrets": "tsx scripts/scan-secrets.mts",
    "check:deploy": "tsx scripts/post-deploy-check.mts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.5.7",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-pdf/renderer": "^4.5.1",
    "@vercel/blob": "^2.6.1",
    "barcode-detector": "^3.2.2",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^7.0.1",
    "csv-stringify": "^6.8.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.29.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "resend": "^6.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.1": true
  }
}
