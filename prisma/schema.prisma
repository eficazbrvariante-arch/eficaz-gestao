// Fase 1: Tenant (empresa) e User (autenticação/usuários).
// Fase 2: Categorias, Marcas, Fornecedores, Produtos e Estoque.
// Fase 3: Clientes, Caixa (CashRegister/CashMovement) e Vendas (Sale/SaleItem/Payment).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                  String       @id @default(cuid())
  name                String
  tradeName           String?
  document            String?
  logoUrl             String?
  primaryColor        String?
  secondaryColor      String?
  phone               String?
  whatsapp            String?
  addressStreet       String?
  addressNumber       String?
  addressCity         String?
  addressState        String?
  addressZip          String?
  subdomain           String       @unique
  // Domínio próprio (Fase 7)
  customDomain        String?      @unique
  domainStatus        DomainStatus @default(NONE)
  /// Valor que a empresa publica num registro TXT para provar que é dona do domínio.
  domainToken         String?
  /// Quando a posse do domínio foi confirmada.
  domainVerifiedAt    DateTime?
  /// Última tentativa de verificação, para mostrar "verificado há X".
  domainCheckedAt     DateTime?
  timezone            String       @default("America/Sao_Paulo")
  currency            String       @default("BRL")
  // Catálogo online (Fase 4)
  catalogEnabled      Boolean      @default(true)
  bannerUrl           String?
  bannerTitle         String?
  bannerSubtitle      String?
  // Pedidos online (Fase 5)
  deliveryEnabled     Boolean      @default(true)
  pickupEnabled       Boolean      @default(true)
  /// Como o estoque reage a um pedido online (ver enum StockPolicy).
  stockPolicy         StockPolicy  @default(RESERVE)
  /// Instruções mostradas ao cliente na retirada (endereço, horário...).
  pickupNotes         String?
  // Plano contratado (Fase 8). Os limites vêm de PLAN_LIMITS, no código —
  // assim ajustar um plano não exige migração nem atualizar cada empresa.
  plan                Plan         @default(FREE)
  // Contadores de numeração sequencial por empresa.
  // Incrementados atomicamente dentro da transação que cria o registro.
  saleSequence        Int          @default(0)
  orderSequence       Int          @default(0)
  repairOrderSequence Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  users          User[]
  categories     Category[]
  brands         Brand[]
  suppliers      Supplier[]
  products       Product[]
  stockMovements StockMovement[]
  customers      Customer[]
  cashRegisters  CashRegister[]
  cashMovements  CashMovement[]
  sales          Sale[]
  orders         Order[]
  deliveryZones  DeliveryZone[]
  auditLogs      AuditLog[]
  repairOrders   RepairOrder[]

  @@map("tenants")
}

/// Planos disponíveis. Os limites de cada um ficam em `src/lib/plans.ts`.
enum Plan {
  FREE
  PRO
  BUSINESS
}

/**
 * Momento em que o pedido online rebaixa o estoque.
 * RESERVE: o estoque só sai quando o pedido é concluído — evita furar o estoque
 * do PDV com pedidos que podem não se confirmar.
 * DEDUCT: o estoque sai assim que o pedido entra — garante o produto para quem
 * pediu online, mas some do balcão antes da confirmação.
 */
enum StockPolicy {
  RESERVE
  DEDUCT
}

/**
 * Etapas da conexão de um domínio próprio ao catálogo.
 * NONE: nenhum domínio cadastrado — a loja só responde pelo subdomínio.
 * PENDING: domínio cadastrado, aguardando o registro TXT de verificação aparecer no DNS.
 * VERIFIED: posse comprovada; falta o apontamento (CNAME) propagar.
 * ACTIVE: domínio verificado e apontando para a aplicação — a loja responde por ele.
 */
enum DomainStatus {
  NONE
  PENDING
  VERIFIED
  ACTIVE
}

enum UserRole {
  ADMIN
  MANAGER
  SELLER
  STOCKIST
}

model User {
  id                  String    @id @default(cuid())
  tenantId            String
  name                String
  email               String    @unique
  passwordHash        String
  role                UserRole  @default(ADMIN)
  active              Boolean   @default(true)
  lastLoginAt         DateTime?
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockMovements      StockMovement[]
  cashMovements       CashMovement[]
  registersOpened     CashRegister[]  @relation("CashRegisterOpenedBy")
  registersClosed     CashRegister[]  @relation("CashRegisterClosedBy")
  salesMade           Sale[]          @relation("SaleSeller")
  salesCancelled      Sale[]          @relation("SaleCancelledBy")
  auditLogs           AuditLog[]
  repairOrdersCreated RepairOrder[]   @relation("RepairOrderCreatedBy")

  @@map("users")
}

/**
 * Registro das ações sensíveis do painel: quem fez, o quê e quando.
 * Guarda o nome do autor além do vínculo, para o histórico continuar legível
 * mesmo se o usuário for removido depois.
 */
model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  /// Nome de quem agiu no momento da ação (snapshot).
  userName    String
  /// O que aconteceu, em código: "sale.cancel", "user.role_change"...
  action      String
  /// Tipo do registro afetado: "Sale", "User", "Product"...
  entity      String
  entityId    String?
  /// Descrição pronta para leitura, montada no momento da ação.
  description String
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model Category {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  parentId  String?
  /// Posição de exibição no catálogo online (menor primeiro). Definida por
  /// arrastar-e-soltar em Produtos → Categorias.
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@map("categories")
}

model Brand {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@map("brands")
}

model Supplier {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  document      String?
  phone         String?
  email         String?
  addressStreet String?
  addressCity   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("suppliers")
}

model Product {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  internalCode  String?
  barcode       String?
  categoryId    String?
  brandId       String?
  supplierId    String?
  description   String?
  costPrice     Decimal  @default(0) @db.Decimal(10, 2)
  salePrice     Decimal  @default(0) @db.Decimal(10, 2)
  promoPrice    Decimal? @db.Decimal(10, 2)
  /// Preço que o cliente efetivamente paga (promocional quando existe, senão o de venda).
  /// Derivado de salePrice/promoPrice e mantido por `computeCatalogPrice` em toda escrita —
  /// existe para o catálogo poder ordenar e filtrar por preço real no banco.
  catalogPrice  Decimal  @default(0) @db.Decimal(10, 2)
  stockQty      Int      @default(0)
  minStock      Int      @default(0)
  active        Boolean  @default(true)
  showInCatalog Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand          Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  supplier       Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  images         ProductImage[]
  variants       ProductVariant[]
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  orderItems     OrderItem[]

  @@unique([tenantId, internalCode])
  @@index([tenantId, active, showInCatalog, catalogPrice])
  @@map("products")
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  order     Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariant {
  id              String  @id @default(cuid())
  productId       String
  name            String
  sku             String?
  barcode         String?
  priceAdjustment Decimal @default(0) @db.Decimal(10, 2)
  stockQty        Int     @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems  SaleItem[]
  orderItems OrderItem[]

  @@map("product_variants")
}

enum StockMovementType {
  IN
  OUT
  ADJUST
  SALE // baixa automática gerada por uma venda no PDV
  CANCEL_RETURN // devolução ao estoque por cancelamento de venda
  ORDER // baixa gerada por um pedido do catálogo online
  ORDER_RETURN // devolução por cancelamento de pedido online
}

model StockMovement {
  id        String            @id @default(cuid())
  tenantId  String
  productId String
  type      StockMovementType
  quantity  Int
  reason    String?
  /// Nulo quando a movimentação foi gerada automaticamente por um pedido
  /// do catálogo, feito por um visitante sem login.
  userId    String?
  saleId    String?
  orderId   String?
  createdAt DateTime          @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])
  sale    Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Fase 3 — Clientes
// ---------------------------------------------------------------------------

model Customer {
  id             String    @id @default(cuid())
  tenantId       String
  name           String
  document       String?
  phone          String?
  whatsapp       String?
  email          String?
  addressStreet  String?
  addressNumber  String?
  addressCity    String?
  addressState   String?
  addressZip     String?
  notes          String?
  // Totais desnormalizados, mantidos pela transação de venda/cancelamento
  // para evitar recalcular a cada listagem.
  totalSpent     Decimal   @default(0) @db.Decimal(12, 2)
  lastPurchaseAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales        Sale[]
  orders       Order[]
  repairOrders RepairOrder[]

  @@index([tenantId, name])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Assistência técnica
// ---------------------------------------------------------------------------

/// Etapas da ordem de serviço, na ordem em que normalmente avançam.
enum RepairOrderStatus {
  RECEIVED // Recebido, aguardando análise
  ANALYZING // Em análise
  AWAITING_APPROVAL // Orçamento enviado, aguardando aprovação do cliente
  APPROVED // Cliente aprovou o orçamento
  IN_REPAIR // Em manutenção
  AWAITING_PART // Aguardando peça
  READY // Pronto para retirada
  DELIVERED // Entregue ao cliente
  CANCELLED // Cancelado
}

model RepairOrder {
  id       String            @id @default(cuid())
  tenantId String
  number   Int
  status   RepairOrderStatus @default(RECEIVED)

  customerId String?

  // Aparelho
  brand           String
  model           String
  color           String?
  imei            String?
  passcode        String?
  turnsOn         Boolean @default(true)
  condition       String?
  reportedDefects String?

  // Serviço
  discount      Decimal   @default(0) @db.Decimal(12, 2)
  internalNotes String?
  estimatedAt   DateTime?
  pickedUpAt    DateTime?

  /// Preço de custo da peça, usado só para calcular a margem internamente.
  /// Visível/editável a qualquer momento apenas por ADMIN; MANAGER só informa
  /// na criação da OS. Nunca exposto a outros perfis nem em relatórios.
  costPrice Decimal? @db.Decimal(12, 2)

  /// URL do comprovante em PDF, gerado sob demanda e cacheado aqui — evita
  /// re-renderizar (e re-subir pro blob) a cada clique em "Enviar por WhatsApp".
  receiptPdfUrl String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy User               @relation("RepairOrderCreatedBy", fields: [createdById], references: [id])
  items     RepairOrderItem[]
  photos    RepairOrderPhoto[]
  events    RepairOrderEvent[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("repair_orders")
}

/// Serviço a realizar no aparelho (troca de peça, mão de obra etc.).
model RepairOrderItem {
  id            String  @id @default(cuid())
  repairOrderId String
  description   String
  unitPrice     Decimal @db.Decimal(10, 2)
  quantity      Int     @default(1)

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)

  @@map("repair_order_items")
}

model RepairOrderPhoto {
  id            String @id @default(cuid())
  repairOrderId String
  url           String
  order         Int    @default(0)

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)

  @@map("repair_order_photos")
}

/// Histórico de ações da OS, mostrado na linha do tempo do atendimento.
model RepairOrderEvent {
  id            String   @id @default(cuid())
  repairOrderId String
  message       String
  createdAt     DateTime @default(now())

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)

  @@map("repair_order_events")
}

// ---------------------------------------------------------------------------
// Fase 3 — Caixa
// ---------------------------------------------------------------------------

enum CashRegisterStatus {
  OPEN
  CLOSED
}

model CashRegister {
  id             String             @id @default(cuid())
  tenantId       String
  status         CashRegisterStatus @default(OPEN)
  openedById     String
  openedAt       DateTime           @default(now())
  openingAmount  Decimal            @db.Decimal(12, 2)
  closedById     String?
  closedAt       DateTime?
  /// Valor efetivamente contado na gaveta no fechamento.
  countedAmount  Decimal?           @db.Decimal(12, 2)
  /// Valor que o sistema esperava (abertura + vendas em dinheiro + suprimentos - sangrias).
  expectedAmount Decimal?           @db.Decimal(12, 2)
  notes          String?

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  openedBy  User           @relation("CashRegisterOpenedBy", fields: [openedById], references: [id])
  closedBy  User?          @relation("CashRegisterClosedBy", fields: [closedById], references: [id])
  movements CashMovement[]
  sales     Sale[]

  @@index([tenantId, status])
  @@map("cash_registers")
}

enum CashMovementType {
  WITHDRAWAL // sangria
  SUPPLY // suprimento
}

model CashMovement {
  id             String           @id @default(cuid())
  tenantId       String
  cashRegisterId String
  type           CashMovementType
  amount         Decimal          @db.Decimal(12, 2)
  description    String?
  userId         String
  createdAt      DateTime         @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@map("cash_movements")
}

// ---------------------------------------------------------------------------
// Fase 3 — Vendas
// ---------------------------------------------------------------------------

enum SaleStatus {
  COMPLETED
  CANCELLED
}

model Sale {
  id             String     @id @default(cuid())
  tenantId       String
  /// Número sequencial por empresa, exibido no comprovante.
  number         Int
  cashRegisterId String
  customerId     String?
  sellerId       String
  status         SaleStatus @default(COMPLETED)
  subtotal       Decimal    @db.Decimal(12, 2)
  discount       Decimal    @default(0) @db.Decimal(12, 2)
  total          Decimal    @db.Decimal(12, 2)
  /// Soma do custo dos itens no momento da venda, para apurar lucro bruto.
  costTotal      Decimal    @default(0) @db.Decimal(12, 2)
  /// Valor em dinheiro recebido do cliente (apenas quando há pagamento em espécie).
  cashReceived   Decimal?   @db.Decimal(12, 2)
  changeAmount   Decimal    @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime   @default(now())
  cancelledAt    DateTime?
  cancelledById  String?
  cancelReason   String?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashRegister   CashRegister    @relation(fields: [cashRegisterId], references: [id])
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  seller         User            @relation("SaleSeller", fields: [sellerId], references: [id])
  cancelledBy    User?           @relation("SaleCancelledBy", fields: [cancelledById], references: [id])
  items          SaleItem[]
  payments       Payment[]
  stockMovements StockMovement[]

  @@unique([tenantId, number])
  @@index([tenantId, createdAt])
  @@map("sales")
}

model SaleItem {
  id           String  @id @default(cuid())
  saleId       String
  productId    String
  variantId    String?
  /// Nome do produto no momento da venda, para o comprovante histórico
  /// não mudar se o produto for renomeado depois.
  nameSnapshot String
  quantity     Int
  unitPrice    Decimal @db.Decimal(10, 2)
  unitCost     Decimal @default(0) @db.Decimal(10, 2)
  total        Decimal @db.Decimal(12, 2)

  sale    Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("sale_items")
}

enum PaymentMethod {
  CASH
  PIX
  DEBIT
  CREDIT
}

model Payment {
  id     String        @id @default(cuid())
  saleId String
  method PaymentMethod
  amount Decimal       @db.Decimal(12, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ---------------------------------------------------------------------------
// Fase 5 — Pedidos do catálogo online
// ---------------------------------------------------------------------------

/// Etapas do pedido, na ordem em que avançam.
enum OrderStatus {
  NEW // Novo — acabou de chegar
  CONFIRMED // Confirmado pela loja
  PREPARING // Em separação
  SHIPPED // Saiu para entrega
  COMPLETED // Concluído (entregue ou retirado)
  CANCELLED // Cancelado
}

enum FulfillmentType {
  DELIVERY // Entrega no endereço do cliente
  PICKUP // Retirada na loja
}

/// Forma de pagamento combinada no pedido — a cobrança acontece fora do sistema.
enum OrderPaymentMethod {
  CASH
  PIX
  DEBIT
  CREDIT
  TO_ARRANGE // A combinar com a loja
}

/// Faixa de entrega com taxa própria, identificada por bairro e/ou CEP.
model DeliveryZone {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  /// Bairro atendido (comparado sem diferenciar maiúsculas/acentos na busca).
  neighborhood String?
  /// Faixa de CEP atendida, apenas dígitos (ex.: 01000000 a 01099999).
  zipStart     String?
  zipEnd       String?
  fee          Decimal  @default(0) @db.Decimal(10, 2)
  /// Prazo estimado exibido ao cliente (ex.: "até 2 horas").
  estimate     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([tenantId, active])
  @@map("delivery_zones")
}

model Order {
  id       String      @id @default(cuid())
  tenantId String
  /// Número sequencial por empresa, informado ao cliente.
  number   Int
  status   OrderStatus @default(NEW)

  // Dados de contato informados no checkout (o visitante não tem conta).
  customerName     String
  customerPhone    String
  customerEmail    String?
  customerDocument String?
  /// Vinculado quando o telefone casa com um cliente já cadastrado.
  customerId       String?

  fulfillment         FulfillmentType
  deliveryZoneId      String?
  addressStreet       String?
  addressNumber       String?
  addressComplement   String?
  addressNeighborhood String?
  addressCity         String?
  addressState        String?
  addressZip          String?

  paymentMethod OrderPaymentMethod
  /// Troco pedido pelo cliente quando o pagamento é em dinheiro.
  changeFor     Decimal?           @db.Decimal(12, 2)

  subtotal    Decimal @db.Decimal(12, 2)
  deliveryFee Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  /// Soma do custo dos itens no momento do pedido, para apurar lucro.
  costTotal   Decimal @default(0) @db.Decimal(12, 2)

  notes           String?
  /// Registrado quando o estoque já foi baixado, para não baixar duas vezes
  /// ao avançar o status (ver StockPolicy).
  stockDeductedAt DateTime?
  cancelReason    String?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deliveryZone   DeliveryZone?   @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  stockMovements StockMovement[]

  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  variantId    String?
  /// Nome do produto no momento do pedido, para o histórico não mudar
  /// se o produto for renomeado depois.
  nameSnapshot String
  quantity     Int
  unitPrice    Decimal @db.Decimal(10, 2)
  unitCost     Decimal @default(0) @db.Decimal(10, 2)
  total        Decimal @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("order_items")
}
