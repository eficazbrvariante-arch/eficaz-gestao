// Fase 1: Tenant (empresa) e User (autenticação/usuários).
// Fase 2: Categorias, Marcas, Fornecedores, Produtos e Estoque.
// Fase 3: Clientes, Caixa (CashRegister/CashMovement) e Vendas (Sale/SaleItem/Payment).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                     String               @id @default(cuid())
  name                   String
  tradeName              String?
  document               String?
  logoUrl                String?
  primaryColor           String?
  secondaryColor         String?
  phone                  String?
  whatsapp               String?
  addressStreet          String?
  addressNumber          String?
  addressCity            String?
  addressState           String?
  addressZip             String?
  subdomain              String               @unique
  /// E-mail de acesso da empresa — identifica o tenant no primeiro login de
  /// cada dispositivo (ver `resolveTenantLoginAction`); depois disso, a
  /// aprovação do dispositivo (`Device`) já resolve o tenant sozinha, sem
  /// precisar digitar de novo. Distinto do e-mail pessoal de cada `User`
  /// (opcional, ver `User.email`) — pode ser trocado livremente sem afetar
  /// a conta de ninguém.
  email                  String               @unique
  // Domínio próprio (Fase 7)
  customDomain           String?              @unique
  domainStatus           DomainStatus         @default(NONE)
  /// Valor que a empresa publica num registro TXT para provar que é dona do domínio.
  domainToken            String?
  /// Quando a posse do domínio foi confirmada.
  domainVerifiedAt       DateTime?
  /// Última tentativa de verificação, para mostrar "verificado há X".
  domainCheckedAt        DateTime?
  timezone               String               @default("America/Sao_Paulo")
  currency               String               @default("BRL")
  // Catálogo online (Fase 4)
  catalogEnabled         Boolean              @default(true)
  bannerUrl              String?
  bannerTitle            String?
  bannerSubtitle         String?
  // Pedidos online (Fase 5)
  deliveryEnabled        Boolean              @default(true)
  pickupEnabled          Boolean              @default(true)
  /// Como o estoque reage a um pedido online (ver enum StockPolicy).
  stockPolicy            StockPolicy          @default(RESERVE)
  /// Instruções mostradas ao cliente na retirada (endereço, horário...).
  pickupNotes            String?
  // Vitrine institucional do catálogo (reformulação "premium")
  instagramUrl           String?
  /// Texto livre "quem somos", exibido numa página institucional própria.
  aboutText              String?
  /// Política de troca — some do rodapé/badges quando não preenchida.
  exchangePolicy         String?
  /// Política de garantia — some do rodapé/badges quando não preenchida.
  warrantyPolicy         String?
  privacyPolicy          String?
  /// Horário de atendimento por dia da semana: array de 7 entradas
  /// `{ day: 0-6, opensAt: "09:00", closesAt: "18:00", closed: boolean }`.
  businessHours          Json?
  /// Oferta Relâmpago por dia da semana: array de 7 entradas
  /// `{ day: 0-6, active, productId, promoPrice, orderLimit, badgeText, icon,
  ///   bgColor, accentColor, soundEnabled }`. Mesma convenção de dia de
  /// `businessHours` (0 = domingo, Date#getDay()).
  flashDealSchedule      Json?
  /// Formas de pagamento que a loja aceita de fato — controla o que aparece
  /// no rodapé/barra de confiança (nunca uma lista fixa no código).
  acceptedPaymentMethods OrderPaymentMethod[]
  /// Parcelamento informativo (sem gateway de cartão integrado). Nulo/0 = desligado.
  maxInstallments        Int?
  minInstallmentValue    Decimal?             @db.Decimal(10, 2)
  // Plano contratado (Fase 8). Os limites vêm de PLAN_LIMITS, no código —
  // assim ajustar um plano não exige migração nem atualizar cada empresa.
  plan                   Plan                 @default(FREE)
  /// Liga a impressão automática do comprovante (window.print()) assim que a
  /// venda é finalizada, na tela do comprovante. O botão manual "Imprimir"
  /// funciona sempre, independente deste campo.
  autoPrintReceipt       Boolean              @default(false)
  // Contadores de numeração sequencial por empresa.
  // Incrementados atomicamente dentro da transação que cria o registro.
  saleSequence           Int                  @default(0)
  orderSequence          Int                  @default(0)
  repairOrderSequence    Int                  @default(0)
  /// Reservado para jornada/escala/tolerância de atraso/banco de horas
  /// configuráveis por empresa (fase futura). Formato livre, não interpretado
  /// em nenhum código ainda — mesma convenção de `businessHours`/`flashDealSchedule`.
  attendanceSettings     Json?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  users                 User[]
  categories            Category[]
  brands                Brand[]
  suppliers             Supplier[]
  products              Product[]
  stockMovements        StockMovement[]
  customers             Customer[]
  cashRegisters         CashRegister[]
  cashMovements         CashMovement[]
  sales                 Sale[]
  saleItemDefects       SaleItemDefect[]
  orders                Order[]
  deliveryZones         DeliveryZone[]
  auditLogs             AuditLog[]
  repairOrders          RepairOrder[]
  creditMovements       CustomerCreditMovement[]
  fiadoEntries          FiadoEntry[]
  devices               Device[]
  visitorSessions       VisitorSession[]
  analyticsEvents       AnalyticsEvent[]
  attendanceEntries     AttendanceEntry[]
  attendanceCorrections AttendanceCorrection[]

  // Central de Atendimento WhatsApp (ver bloco "Fase 9" no fim do arquivo).
  whatsAppIntegration   WhatsAppIntegration?
  whatsAppContacts      WhatsAppContact[]
  whatsAppConversations WhatsAppConversation[]
  whatsAppMessages      WhatsAppMessage[]
  whatsAppQueues        WhatsAppQueue[]
  whatsAppTags          WhatsAppTag[]
  whatsAppQuickReplies  WhatsAppQuickReply[]

  @@map("tenants")
}

/// Planos disponíveis. Os limites de cada um ficam em `src/lib/plans.ts`.
enum Plan {
  FREE
  PRO
  BUSINESS
}

/**
 * Momento em que o pedido online rebaixa o estoque.
 * RESERVE: o estoque só sai quando o pedido é concluído — evita furar o estoque
 * do PDV com pedidos que podem não se confirmar.
 * DEDUCT: o estoque sai assim que o pedido entra — garante o produto para quem
 * pediu online, mas some do balcão antes da confirmação.
 */
enum StockPolicy {
  RESERVE
  DEDUCT
}

/**
 * Etapas da conexão de um domínio próprio ao catálogo.
 * NONE: nenhum domínio cadastrado — a loja só responde pelo subdomínio.
 * PENDING: domínio cadastrado, aguardando o registro TXT de verificação aparecer no DNS.
 * VERIFIED: posse comprovada; falta o apontamento (CNAME) propagar.
 * ACTIVE: domínio verificado e apontando para a aplicação — a loja responde por ele.
 */
enum DomainStatus {
  NONE
  PENDING
  VERIFIED
  ACTIVE
}

enum UserRole {
  ADMIN
  MANAGER
  SELLER
  STOCKIST
  /// Só vê a foto e edita a quantidade em estoque de qualquer produto; sem
  /// acesso a preços nem a qualquer outra tela do painel.
  STOCK_COLLABORATOR
}

model User {
  id                  String    @id @default(cuid())
  tenantId            String
  name                String
  /// Opcional — o login não depende mais do e-mail pessoal do colaborador
  /// (ver `Tenant.email`). Quando preenchido, ainda serve para
  /// autosserviço de "esqueci minha senha" (`resetToken`); sem ele, só um
  /// admin pode redefinir a senha da pessoa em `/usuarios`.
  email               String?   @unique
  passwordHash        String
  role                UserRole  @default(ADMIN)
  active              Boolean   @default(true)
  lastLoginAt         DateTime?
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockMovements          StockMovement[]
  cashMovements           CashMovement[]
  registersOpened         CashRegister[]           @relation("CashRegisterOpenedBy")
  registersClosed         CashRegister[]           @relation("CashRegisterClosedBy")
  salesMade               Sale[]                   @relation("SaleSeller")
  salesCancelled          Sale[]                   @relation("SaleCancelledBy")
  salesAssisted           Sale[]                   @relation("SaleAssistantSeller")
  saleItemDefectsReported SaleItemDefect[]
  auditLogs               AuditLog[]
  repairOrdersCreated     RepairOrder[]            @relation("RepairOrderCreatedBy")
  creditMovements         CustomerCreditMovement[]
  fiadoEntriesCreated     FiadoEntry[]
  devicesRequested        Device[]                 @relation("DeviceRequestedBy")
  devicesStatusChanged    Device[]                 @relation("DeviceStatusChangedBy")

  attendanceEntries         AttendanceEntry[]      @relation("AttendanceEntryUser")
  attendanceSelfieWaivedFor AttendanceEntry[]      @relation("AttendanceEntrySelfieWaivedBy")
  attendanceCorrectionsMade AttendanceCorrection[] @relation("AttendanceCorrectionBy")

  whatsAppConversationsAssigned WhatsAppConversation[] @relation("WhatsAppConversationAssignedTo")
  whatsAppMessagesSent          WhatsAppMessage[]      @relation("WhatsAppMessageSender")

  @@map("users")
}

/**
 * Registro das ações sensíveis do painel: quem fez, o quê e quando.
 * Guarda o nome do autor além do vínculo, para o histórico continuar legível
 * mesmo se o usuário for removido depois.
 */
model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  /// Nome de quem agiu no momento da ação (snapshot).
  userName    String
  /// O que aconteceu, em código: "sale.cancel", "user.role_change"...
  action      String
  /// Tipo do registro afetado: "Sale", "User", "Product"...
  entity      String
  entityId    String?
  /// Descrição pronta para leitura, montada no momento da ação.
  description String
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

/// PENDING: aguardando aprovação do admin. APPROVED: libera login. REJECTED: recusado
/// ou revogado (mesmo efeito — bloqueado; o texto do log de auditoria diferencia).
enum DeviceStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Um navegador/computador que já tentou logar num tenant. O id desta linha é o
/// próprio valor guardado no cookie `device_id` do navegador — ver `src/lib/auth.ts`
/// (`authorize()`) e `src/modules/devices/device-service.ts`.
model Device {
  id                String       @id @default(cuid())
  tenantId          String
  status            DeviceStatus @default(PENDING)
  ipAddress         String?
  userAgent         String?
  requestedByUserId String?
  /// Quem/quando mexeu no status por último (aprovar, recusar ou revogar reaproveitam
  /// estes dois campos — o histórico detalhado de cada ação fica no AuditLog).
  statusChangedById String?
  statusChangedAt   DateTime?
  lastSeenAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy     User?  @relation("DeviceRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  statusChangedBy User?  @relation("DeviceStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: SetNull)

  attendanceEntries AttendanceEntry[]

  @@index([tenantId, status])
  @@map("devices")
}

// ---------------------------------------------------------------------------
// Controle de Ponto
// ---------------------------------------------------------------------------

enum AttendanceEntryType {
  CLOCK_IN // Entrada
  BREAK_START // Saída para intervalo
  BREAK_END // Retorno do intervalo
  CLOCK_OUT // Saída / fim de expediente
}

/// Uma marcação de ponto. Imutável por design: nunca sofre UPDATE depois de
/// criada — qualquer correção vira uma linha nova em `AttendanceCorrection`,
/// vinculada a esta (ver `resolveEffectiveAttendanceEntry`). O tipo nunca é
/// escolhido pelo colaborador: é sempre calculado no servidor a partir das
/// marcações do dia (ver `getNextExpectedAttendanceType`).
model AttendanceEntry {
  id                 String              @id @default(cuid())
  tenantId           String
  userId             String
  type               AttendanceEntryType
  /// Horário real da marcação (não necessariamente igual a `createdAt`, para
  /// deixar espaço a uma eventual sincronização offline no futuro).
  occurredAt         DateTime            @default(now())
  selfieUrl          String?
  /// Marcação feita sem selfie, mediante permissão administrativa (ver
  /// `canWaiveAttendanceSelfie`) — sempre acompanhada de motivo e também
  /// registrada em `AuditLog` ("attendance.selfie_waived").
  selfieWaived       Boolean             @default(false)
  selfieWaivedById   String?
  selfieWaivedReason String?
  /// Reaproveita o cookie `device_id` já existente (ver model `Device`) —
  /// nulo quando a marcação não teve um dispositivo aprovado associável.
  deviceId           String?
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime            @default(now())

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User                   @relation("AttendanceEntryUser", fields: [userId], references: [id])
  selfieWaivedBy User?                  @relation("AttendanceEntrySelfieWaivedBy", fields: [selfieWaivedById], references: [id], onDelete: SetNull)
  device         Device?                @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  corrections    AttendanceCorrection[]

  @@index([tenantId, userId, occurredAt])
  @@index([tenantId, occurredAt])
  @@map("attendance_entries")
}

/// Correção administrativa de uma marcação. Aditiva: nunca apaga nem edita a
/// `AttendanceEntry` original — preserva valor original, novo valor,
/// responsável e motivo. O valor "efetivo" de uma marcação corrigida é
/// sempre a correção mais recente por `createdAt` (ver
/// `resolveEffectiveAttendanceEntry`), nunca uma sobrescrita silenciosa.
model AttendanceCorrection {
  id                 String              @id @default(cuid())
  tenantId           String
  entryId            String
  correctedById      String
  originalType       AttendanceEntryType
  originalOccurredAt DateTime
  newType            AttendanceEntryType
  newOccurredAt      DateTime
  reason             String
  createdAt          DateTime            @default(now())

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entry       AttendanceEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  correctedBy User            @relation("AttendanceCorrectionBy", fields: [correctedById], references: [id])

  @@index([tenantId, entryId, createdAt])
  @@index([tenantId, createdAt])
  @@map("attendance_corrections")
}

model Category {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  parentId    String?
  /// Posição de exibição no catálogo online (menor primeiro). Definida por
  /// arrastar-e-soltar em Produtos → Categorias.
  order       Int      @default(0)
  /// Chave de um ícone fixo (ver `src/app/loja/[subdomain]/icons.tsx`). Não é
  /// mais exibido em lugar nenhum do catálogo online; mantido para não perder
  /// o que já foi cadastrado, caso volte a ser usado.
  icon        String?
  /// Categoria de venda exclusiva no balcão da loja física (ex.: películas,
  /// capinhas) — produtos dela nunca aparecem no catálogo online, em nenhuma
  /// hipótese (listagem, busca, categoria ou link direto do produto).
  counterOnly Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@map("categories")
}

model Brand {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@map("brands")
}

model Supplier {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  document      String?
  phone         String?
  email         String?
  addressStreet String?
  addressCity   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("suppliers")
}

model Product {
  id               String    @id @default(cuid())
  tenantId         String
  name             String
  internalCode     String?
  barcode          String?
  categoryId       String?
  brandId          String?
  supplierId       String?
  description      String?
  costPrice        Decimal   @default(0) @db.Decimal(10, 2)
  salePrice        Decimal   @default(0) @db.Decimal(10, 2)
  promoPrice       Decimal?  @db.Decimal(10, 2)
  /// Preço que o cliente efetivamente paga (promocional quando existe, senão o de venda).
  /// Derivado de salePrice/promoPrice e mantido por `computeCatalogPrice` em toda escrita —
  /// existe para o catálogo poder ordenar e filtrar por preço real no banco.
  catalogPrice     Decimal   @default(0) @db.Decimal(10, 2)
  /// Início agendado da oferta relâmpago (opcional). Nulo = já vale a partir
  /// de quando `promoPrice` foi definido.
  promoStartedAt   DateTime?
  /// Fim da oferta relâmpago. Só faz sentido junto de `promoPrice`; nulo = promoção comum.
  promoEndsAt      DateTime?
  /// Quantidade disponível só nesta promoção (opcional). O valor exibido ao
  /// cliente é sempre `min(promoStockLimit, stockQty)` — nunca inventa número
  /// além do estoque real, só limita a promoção a um teto menor se o lojista quiser.
  promoStockLimit  Int?
  stockQty         Int       @default(0)
  minStock         Int       @default(0)
  active           Boolean   @default(true)
  showInCatalog    Boolean   @default(true)
  /// Destaque manual — fura a fila na listagem geral do catálogo e entra
  /// primeiro no carrossel "Destaques" da home, sem misturar com o ranking
  /// real de vendas (ver `listBestSellers`, que continua 100% orgânico).
  isFeatured       Boolean   @default(false)
  /// Posição manual entre os destaques (menor aparece primeiro). Nulo = sem
  /// ordem definida, entra depois dos ordenados, por `updatedAt`.
  featuredOrder    Int?
  /// Fim opcional do período de destaque — depois disso o produto sai
  /// sozinho do carrossel "Destaques" mesmo com `isFeatured` ainda marcado.
  featuredUntil    DateTime?
  /// Média das avaliações lançadas (desnormalizada, ver `ProductReview`) —
  /// evita agregação por produto em toda renderização de card.
  avgRating        Decimal?  @db.Decimal(2, 1)
  reviewCount      Int       @default(0)
  /// Quando o Colaborador de Estoque confirmou esse produto no ciclo de
  /// contagem atual. Nulo = ainda pendente (aparece na fila dele). Zerado
  /// em massa quando um novo ciclo de contagem é iniciado.
  lastStockCheckAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand          Brand?                @relation(fields: [brandId], references: [id], onDelete: SetNull)
  supplier       Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  images         ProductImage[]
  variants       ProductVariant[]
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  orderItems     OrderItem[]
  priceHistory   ProductPriceHistory[]
  reviews        ProductReview[]

  @@unique([tenantId, internalCode])
  @@index([tenantId, active, showInCatalog, catalogPrice])
  @@map("products")
}

/**
 * Histórico do preço efetivamente praticado, usado para calcular o "de/por"
 * exigido pela Lei do Preço Riscado (menor preço dos últimos 30 dias).
 * Uma linha nova só é gravada quando o preço efetivo muda de fato — ver
 * `recordPriceSnapshotIfChanged` em `src/modules/products/price-history.ts`.
 */
model ProductPriceHistory {
  id             String   @id @default(cuid())
  tenantId       String
  productId      String
  /// `computeCatalogPrice(salePrice, promoPrice)` no momento do registro.
  effectivePrice Decimal  @db.Decimal(10, 2)
  recordedAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId, recordedAt])
  @@map("product_price_history")
}

/**
 * Avaliação lançada manualmente pelo lojista (sem formulário público nesta
 * fase) — ex.: comentário recebido no WhatsApp, Google ou na loja física.
 */
model ProductReview {
  id         String   @id @default(cuid())
  tenantId   String
  productId  String
  authorName String
  /// Nota de 1 a 5.
  rating     Int
  comment    String?
  /// De onde veio a avaliação real (ex.: "WhatsApp", "Google", "Loja física") —
  /// só para avaliação manual lançada pelo lojista. Avaliação de compra
  /// verificada (`customerId` preenchido) não usa este campo.
  source     String?
  /// Preenchido quando a avaliação vem do próprio cliente logado (compra
  /// verificada, ver `hasCustomerPurchasedProduct`); nulo para as avaliações
  /// manuais que o lojista lança a partir de fora da plataforma.
  customerId String?
  createdAt  DateTime @default(now())

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([tenantId, productId, customerId])
  @@index([tenantId, productId])
  @@map("product_reviews")
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  order     Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariant {
  id              String  @id @default(cuid())
  productId       String
  name            String
  sku             String?
  barcode         String?
  priceAdjustment Decimal @default(0) @db.Decimal(10, 2)
  stockQty        Int     @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems  SaleItem[]
  orderItems OrderItem[]

  @@map("product_variants")
}

enum StockMovementType {
  IN
  OUT
  ADJUST
  SALE // baixa automática gerada por uma venda no PDV
  CANCEL_RETURN // devolução ao estoque por cancelamento de venda
  ORDER // baixa gerada por um pedido do catálogo online
  ORDER_RETURN // devolução por cancelamento de pedido online
}

model StockMovement {
  id        String            @id @default(cuid())
  tenantId  String
  productId String
  type      StockMovementType
  quantity  Int
  reason    String?
  /// Nulo quando a movimentação foi gerada automaticamente por um pedido
  /// do catálogo, feito por um visitante sem login.
  userId    String?
  saleId    String?
  orderId   String?
  createdAt DateTime          @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])
  sale    Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Fase 3 — Clientes
// ---------------------------------------------------------------------------

model Customer {
  id                  String    @id @default(cuid())
  tenantId            String
  name                String
  document            String?
  phone               String?
  whatsapp            String?
  email               String?
  addressStreet       String?
  addressNumber       String?
  addressCity         String?
  addressState        String?
  addressZip          String?
  notes               String?
  /// Reservado para ações de relacionamento futuras (ex.: mensagem de aniversário).
  birthDate           DateTime?
  // Totais desnormalizados, mantidos pela transação de venda/cancelamento
  // para evitar recalcular a cada listagem.
  totalSpent          Decimal   @default(0) @db.Decimal(12, 2)
  lastPurchaseAt      DateTime?
  /// Saldo de crédito de loja (gerado por cancelamento, usável como forma de
  /// pagamento numa venda futura). Mantido pela mesma transação que gera ou
  /// resgata o crédito — nunca recalculado a partir do histórico.
  creditBalance       Decimal   @default(0) @db.Decimal(12, 2)
  /// Login da loja pública (checkout com conta) — nulo para clientes cadastrados
  /// manualmente pelo lojista, que nunca ganharam login. Formato exibido como
  /// "@handle", guardado sem o "@". Único por loja, não globalmente.
  username            String?
  passwordHash        String?
  lastLoginAt         DateTime?
  /// Token de recuperação de senha (hash SHA-256, nunca o valor em claro —
  /// mesmo padrão de `User.resetToken`). Único globalmente: é só uma chave
  /// de busca, não precisa (nem faz sentido) ser único por loja.
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales            Sale[]
  orders           Order[]
  creditMovements  CustomerCreditMovement[]
  fiadoEntries     FiadoEntry[]
  repairOrders     RepairOrder[]
  sessions         CustomerSession[]
  reviews          ProductReview[]
  whatsAppContacts WhatsAppContact[]

  @@unique([tenantId, username])
  @@index([tenantId, name])
  @@map("customers")
}

/// Sessão de login da loja pública (Customer) — inteiramente separada da sessão
/// NextAuth de User/funcionário. O cookie do navegador carrega só um token opaco;
/// aqui fica somente o hash (SHA-256) desse token, nunca o valor em claro, para um
/// vazamento do banco não virar sessão utilizável (ver `customer-session.ts`).
model CustomerSession {
  id         String    @id @default(cuid())
  tenantId   String
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  /// Preenchido ao revogar (logout, troca de conta, rotação em novo login) — a
  /// sessão nunca é reaproveitada depois disso, mesmo antes de expirar.
  revokedAt  DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@index([expiresAt])
  @@map("customer_sessions")
}

/// Tentativa de login (bem-sucedida ou não) na loja pública, usada só para limitar
/// força bruta por usuário e por IP sem depender de infraestrutura externa. Uma
/// linha por tentativa; limpa periodicamente por `scripts/limpar-sessoes-expiradas.mts`.
model CustomerLoginAttempt {
  id        String   @id @default(cuid())
  tenantId  String
  username  String
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([tenantId, username, createdAt])
  @@index([tenantId, ipAddress, createdAt])
  @@map("customer_login_attempts")
}

/// Extrato de crédito de loja por cliente — cada linha soma (GRANTED) ou
/// subtrai (REDEEMED) de `Customer.creditBalance`. `saleId` aponta pra venda
/// que originou o crédito (cancelamento) ou pra venda onde ele foi usado.
model CustomerCreditMovement {
  id         String             @id @default(cuid())
  tenantId   String
  customerId String
  type       CreditMovementType
  amount     Decimal            @db.Decimal(12, 2)
  saleId     String?
  userId     String?
  reason     String?
  createdAt  DateTime           @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale     Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
  user     User?    @relation(fields: [userId], references: [id])

  @@index([tenantId, customerId, createdAt])
  @@map("customer_credit_movements")
}

// ---------------------------------------------------------------------------
// Assistência técnica
// ---------------------------------------------------------------------------

/// Etapas da ordem de serviço, na ordem em que normalmente avançam.
enum RepairOrderStatus {
  RECEIVED // Recebido, aguardando análise
  ANALYZING // Em análise
  AWAITING_APPROVAL // Orçamento enviado, aguardando aprovação do cliente
  APPROVED // Cliente aprovou o orçamento
  IN_REPAIR // Em manutenção
  AWAITING_PART // Aguardando peça
  READY // Pronto para retirada
  DELIVERED // Entregue ao cliente
  CANCELLED // Cancelado
}

model RepairOrder {
  id       String            @id @default(cuid())
  tenantId String
  number   Int
  status   RepairOrderStatus @default(RECEIVED)

  customerId String?

  // Aparelho
  brand           String
  model           String
  color           String?
  imei            String?
  passcode        String?
  turnsOn         Boolean @default(true)
  condition       String?
  reportedDefects String?

  // Serviço
  discount      Decimal   @default(0) @db.Decimal(12, 2)
  internalNotes String?
  estimatedAt   DateTime?
  pickedUpAt    DateTime?

  /// Preço de custo da peça, usado só para calcular a margem internamente.
  /// Visível/editável a qualquer momento apenas por ADMIN; MANAGER só informa
  /// na criação da OS. Nunca exposto a outros perfis nem em relatórios.
  costPrice Decimal? @db.Decimal(12, 2)

  /// URL do comprovante em PDF, gerado sob demanda e cacheado aqui — evita
  /// re-renderizar (e re-subir pro blob) a cada clique em "Enviar por WhatsApp".
  receiptPdfUrl String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy User               @relation("RepairOrderCreatedBy", fields: [createdById], references: [id])
  items     RepairOrderItem[]
  photos    RepairOrderPhoto[]
  events    RepairOrderEvent[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("repair_orders")
}

/// Serviço a realizar no aparelho (troca de peça, mão de obra etc.).
model RepairOrderItem {
  id            String  @id @default(cuid())
  repairOrderId String
  description   String
  unitPrice     Decimal @db.Decimal(10, 2)
  quantity      Int     @default(1)

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)

  @@map("repair_order_items")
}

model RepairOrderPhoto {
  id            String @id @default(cuid())
  repairOrderId String
  url           String
  order         Int    @default(0)

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)

  @@map("repair_order_photos")
}

/// Histórico de ações da OS, mostrado na linha do tempo do atendimento.
model RepairOrderEvent {
  id            String   @id @default(cuid())
  repairOrderId String
  message       String
  createdAt     DateTime @default(now())

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)

  @@map("repair_order_events")
}

// ---------------------------------------------------------------------------
// Fase 3 — Caixa
// ---------------------------------------------------------------------------

enum CashRegisterStatus {
  OPEN
  CLOSED
}

model CashRegister {
  id             String             @id @default(cuid())
  tenantId       String
  status         CashRegisterStatus @default(OPEN)
  openedById     String
  openedAt       DateTime           @default(now())
  openingAmount  Decimal            @db.Decimal(12, 2)
  closedById     String?
  closedAt       DateTime?
  /// Valor efetivamente contado na gaveta no fechamento.
  countedAmount  Decimal?           @db.Decimal(12, 2)
  /// Valor que o sistema esperava (abertura + vendas em dinheiro + suprimentos - sangrias).
  expectedAmount Decimal?           @db.Decimal(12, 2)
  /// Valor conferido pelo vendedor no fechamento para cada forma de pagamento
  /// que não passa pela gaveta física (débito, crédito, Pix) — e o que o
  /// sistema esperava para cada uma, para calcular a diferença por forma.
  countedDebitAmount   Decimal? @db.Decimal(12, 2)
  expectedDebitAmount  Decimal? @db.Decimal(12, 2)
  countedCreditAmount  Decimal? @db.Decimal(12, 2)
  expectedCreditAmount Decimal? @db.Decimal(12, 2)
  countedPixAmount     Decimal? @db.Decimal(12, 2)
  expectedPixAmount    Decimal? @db.Decimal(12, 2)
  notes          String?

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  openedBy  User           @relation("CashRegisterOpenedBy", fields: [openedById], references: [id])
  closedBy  User?          @relation("CashRegisterClosedBy", fields: [closedById], references: [id])
  movements CashMovement[]
  sales     Sale[]

  @@index([tenantId, status])
  @@map("cash_registers")
}

enum CashMovementType {
  WITHDRAWAL // sangria
  SUPPLY // suprimento
}

model CashMovement {
  id             String           @id @default(cuid())
  tenantId       String
  cashRegisterId String
  type           CashMovementType
  amount         Decimal          @db.Decimal(12, 2)
  description    String?
  userId         String
  createdAt      DateTime         @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@map("cash_movements")
}

// ---------------------------------------------------------------------------
// Fase 3 — Vendas
// ---------------------------------------------------------------------------

enum SaleStatus {
  COMPLETED
  CANCELLED
}

model Sale {
  id                String     @id @default(cuid())
  tenantId          String
  /// Número sequencial por empresa, exibido no comprovante.
  number            Int
  cashRegisterId    String
  customerId        String?
  sellerId          String
  /// Segunda pessoa envolvida na venda (opcional). Só estrutura de dados —
  /// nenhuma regra de comissão/relatório usa este campo ainda.
  assistantSellerId String?
  status            SaleStatus @default(COMPLETED)
  subtotal          Decimal    @db.Decimal(12, 2)
  discount          Decimal    @default(0) @db.Decimal(12, 2)
  total             Decimal    @db.Decimal(12, 2)
  /// Soma do custo dos itens no momento da venda, para apurar lucro bruto.
  costTotal         Decimal    @default(0) @db.Decimal(12, 2)
  /// Valor em dinheiro recebido do cliente (apenas quando há pagamento em espécie).
  cashReceived      Decimal?   @db.Decimal(12, 2)
  changeAmount      Decimal    @default(0) @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime   @default(now())
  cancelledAt       DateTime?
  cancelledById     String?
  cancelReason      String?

  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashRegister    CashRegister             @relation(fields: [cashRegisterId], references: [id])
  customer        Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  seller          User                     @relation("SaleSeller", fields: [sellerId], references: [id])
  assistantSeller User?                    @relation("SaleAssistantSeller", fields: [assistantSellerId], references: [id], onDelete: SetNull)
  cancelledBy     User?                    @relation("SaleCancelledBy", fields: [cancelledById], references: [id])
  items           SaleItem[]
  payments        Payment[]
  stockMovements  StockMovement[]
  creditMovements CustomerCreditMovement[]
  fiadoEntries    FiadoEntry[]
  itemDefects     SaleItemDefect[]

  @@unique([tenantId, number])
  @@index([tenantId, createdAt])
  @@map("sales")
}

model SaleItem {
  id           String  @id @default(cuid())
  saleId       String
  productId    String
  variantId    String?
  /// Nome do produto no momento da venda, para o comprovante histórico
  /// não mudar se o produto for renomeado depois.
  nameSnapshot String
  quantity     Int
  unitPrice    Decimal @db.Decimal(10, 2)
  unitCost     Decimal @default(0) @db.Decimal(10, 2)
  /// Desconto concedido só neste item — `total` já sai líquido dele
  /// (unitPrice × quantity − discount).
  discount     Decimal @default(0) @db.Decimal(12, 2)
  total        Decimal @db.Decimal(12, 2)

  sale    Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  defects SaleItemDefect[]

  @@map("sale_items")
}

/// Registro de "troca por defeito" de um item específico de uma venda —
/// não mexe na venda original (total/subtotal ficam intactos, como fato
/// histórico do que foi vendido). Gera crédito de loja pro cliente e fica
/// só como marca "Trocado por defeito" no item, no comprovante. O produto
/// devolvido NÃO volta a contar no estoque vendável (pode estar com
/// defeito) — quem ajusta isso de volta, se for o caso, é um ajuste manual
/// de estoque.
model SaleItemDefect {
  id           String   @id @default(cuid())
  tenantId     String
  saleId       String
  saleItemId   String
  quantity     Int
  reason       String
  /// Valor de crédito de loja gerado por este registro (unitPrice do item × quantity).
  creditAmount Decimal  @db.Decimal(12, 2)
  reportedById String
  reportedAt   DateTime @default(now())

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale       Sale                  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleItem   SaleItem              @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  reportedBy User                  @relation(fields: [reportedById], references: [id])
  photos     SaleItemDefectPhoto[]

  @@index([tenantId, saleId])
  @@map("sale_item_defects")
}

model SaleItemDefectPhoto {
  id               String @id @default(cuid())
  saleItemDefectId String
  url              String
  order            Int    @default(0)

  saleItemDefect SaleItemDefect @relation(fields: [saleItemDefectId], references: [id], onDelete: Cascade)

  @@map("sale_item_defect_photos")
}

enum PaymentMethod {
  CASH
  PIX
  DEBIT
  CREDIT
  /// Crédito de loja (saldo do cliente, gerado por cancelamento de venda ou
  /// concedido manualmente pelo administrador).
  STORE_CREDIT
  /// Fiado: cliente leva o produto agora, paga depois — vira um `FiadoEntry`
  /// pendente. Só disponível pra quem pode conceder fiado (ver
  /// `canManageFiado`) e com cliente selecionado na venda.
  FIADO
}

/// GRANTED: crédito gerado (ex.: cancelamento de venda, ou concedido
/// manualmente pelo administrador). REDEEMED: usado como forma de pagamento
/// numa venda nova. O valor em `CustomerCreditMovement.amount` é sempre
/// positivo — o sinal é implícito pelo tipo.
enum CreditMovementType {
  GRANTED
  REDEEMED
}

/// PAID é um estado final (nunca mais some da lista, só muda o status).
/// "Vencido" não é um valor guardado — é calculado a partir de PENDING +
/// `dueDate` no passado (ver `isFiadoOverdue`), pra nunca ficar desatualizado.
enum FiadoStatus {
  PENDING
  PAID
}

/// Fiado: venda feita "na confiança", cliente paga depois. Sempre lançado por
/// um ADMIN (`canManageFiado`) — seja automaticamente ao fechar uma venda no
/// PDV com a forma de pagamento "Fiado" (`saleId` preenchido), seja manual
/// pela ficha do cliente (`saleId` nulo, ex.: produto entregue fora do PDV).
model FiadoEntry {
  id          String      @id @default(cuid())
  tenantId    String
  customerId  String
  amount      Decimal     @db.Decimal(12, 2)
  status      FiadoStatus @default(PENDING)
  /// Data prevista de pagamento. Só relevante enquanto `status` é PENDING —
  /// depois dela, o lançamento pendente aparece como "Vencido" na UI.
  dueDate     DateTime?
  note        String?
  /// Preenchido só quando o lançamento nasceu de uma venda no PDV (forma de
  /// pagamento "Fiado"); nulo nos lançamentos manuais.
  saleId      String?
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale      Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, status, dueDate])
  @@map("fiado_entries")
}

model Payment {
  id     String        @id @default(cuid())
  saleId String
  method PaymentMethod
  amount Decimal       @db.Decimal(12, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ---------------------------------------------------------------------------
// Fase 5 — Pedidos do catálogo online
// ---------------------------------------------------------------------------

/// Etapas do pedido, na ordem em que avançam.
enum OrderStatus {
  NEW // Novo — acabou de chegar
  CONFIRMED // Confirmado pela loja
  PREPARING // Em separação
  SHIPPED // Saiu para entrega
  COMPLETED // Concluído (entregue ou retirado)
  CANCELLED // Cancelado
}

enum FulfillmentType {
  DELIVERY // Entrega no endereço do cliente
  PICKUP // Retirada na loja
}

/// Origem do pedido — ver comentário do campo `Order.origin`.
enum OrderOrigin {
  CHECKOUT
  WHATSAPP
}

/// Forma de pagamento combinada no pedido — a cobrança acontece fora do sistema.
enum OrderPaymentMethod {
  CASH
  PIX
  DEBIT
  CREDIT
  TO_ARRANGE // A combinar com a loja
}

/// Faixa de entrega com taxa própria, identificada por bairro e/ou CEP.
model DeliveryZone {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  /// Bairro atendido (comparado sem diferenciar maiúsculas/acentos na busca).
  neighborhood    String?
  /// Faixa de CEP atendida, apenas dígitos (ex.: 01000000 a 01099999).
  zipStart        String?
  zipEnd          String?
  fee             Decimal  @default(0) @db.Decimal(10, 2)
  /// Subtotal do pedido a partir do qual a entrega fica grátis nesta faixa.
  /// Nulo = sem frete grátis.
  freeShippingMin Decimal? @db.Decimal(10, 2)
  /// Prazo estimado exibido ao cliente (ex.: "até 2 horas").
  estimate        String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([tenantId, active])
  @@map("delivery_zones")
}

model Order {
  id       String      @id @default(cuid())
  tenantId String
  /// Número sequencial por empresa, informado ao cliente.
  number   Int
  status   OrderStatus @default(NEW)

  // Dados de contato informados no checkout (o visitante não tem conta).
  customerName      String
  customerPhone     String
  customerEmail     String?
  customerDocument  String?
  /// Conta que fez o pedido (criada ou autenticada no checkout, ver
  /// `registerCustomer`/`authenticateCustomer`) — nunca inferido por telefone.
  customerId        String?
  /// Token opaco para consultar o pedido publicamente sem login (ex.: link de
  /// confirmação enviado por WhatsApp). Não substitui a checagem de sessão em
  /// `pedido/[id]`, só cobre o caso de acesso sem conta ativa no navegador.
  publicAccessToken String  @unique @default(cuid())

  /// De onde veio o pedido: `CHECKOUT` (carrinho/checkout normal, com entrega
  /// e pagamento já definidos) ou `WHATSAPP` (clique em "Comprar pelo
  /// WhatsApp" na página do produto — vira pedido pendente para o cliente
  /// aparecer em "Pedidos online", mas entrega/pagamento só são combinados
  /// depois, na conversa).
  origin OrderOrigin @default(CHECKOUT)

  /// Nulo apenas em pedidos `origin: WHATSAPP`, até a loja combinar com o
  /// cliente pelo chat.
  fulfillment         FulfillmentType?
  deliveryZoneId      String?
  addressStreet       String?
  addressNumber       String?
  addressComplement   String?
  addressNeighborhood String?
  addressCity         String?
  addressState        String?
  addressZip          String?

  /// Nulo apenas em pedidos `origin: WHATSAPP` (ver `fulfillment`).
  paymentMethod OrderPaymentMethod?
  /// Troco pedido pelo cliente quando o pagamento é em dinheiro.
  changeFor     Decimal?            @db.Decimal(12, 2)

  subtotal    Decimal @db.Decimal(12, 2)
  deliveryFee Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  /// Soma do custo dos itens no momento do pedido, para apurar lucro.
  costTotal   Decimal @default(0) @db.Decimal(12, 2)

  notes           String?
  /// Registrado quando o estoque já foi baixado, para não baixar duas vezes
  /// ao avançar o status (ver StockPolicy).
  stockDeductedAt DateTime?
  cancelReason    String?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deliveryZone   DeliveryZone?   @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  stockMovements StockMovement[]

  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  variantId    String?
  /// Nome do produto no momento do pedido, para o histórico não mudar
  /// se o produto for renomeado depois.
  nameSnapshot String
  quantity     Int
  unitPrice    Decimal @db.Decimal(10, 2)
  unitCost     Decimal @default(0) @db.Decimal(10, 2)
  total        Decimal @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

/// Como o visitante chegou na loja, categorizado a partir do `document.referrer`
/// (capturado uma única vez, na criação da sessão — navegação interna nunca muda o
/// referrer). OTHER cobre qualquer referrer real que não bata com as categorias
/// nomeadas; DIRECT é referrer vazio (digitou o endereço, favoritos, apps).
enum TrafficSource {
  GOOGLE
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  DIRECT
  OTHER
}

enum DeviceType {
  MOBILE
  TABLET
  DESKTOP
}

/// Cada etapa do funil de conversão da loja, mais os dois passos específicos do
/// popup da Oferta Relâmpago (FLASH_VIEW/FLASH_CLICK). `isFlashDeal` em
/// `AnalyticsEvent` marca quando PRODUCT_VIEW/ADD_TO_CART/PURCHASE também contam
/// pro funil da oferta do dia.
enum AnalyticsEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  ADD_TO_CART
  CHECKOUT_START
  PURCHASE
  FLASH_VIEW
  FLASH_CLICK
}

/// Uma visita (aba do navegador) na loja pública. O id é o próprio identificador
/// gerado no cliente (sessionStorage) — mesma convenção de `Device.id` guardar o
/// valor do cookie. Linha de longa duração, atualizada a cada evento/heartbeat;
/// os eventos em si ficam em `AnalyticsEvent`.
model VisitorSession {
  id            String        @id
  tenantId      String
  /// Identidade de longo prazo do navegador (localStorage) — usada para contar
  /// "visitantes únicos", diferente desta sessão que expira com a aba.
  visitorId     String
  deviceType    DeviceType    @default(DESKTOP)
  trafficSource TrafficSource @default(DIRECT)
  /// Hostname bruto do referrer (ex.: "l.instagram.com"), só para auditar o
  /// balde "Outro" quando a categorização não reconhece a origem.
  referrerHost  String?
  geoCity       String?
  geoState      String?
  geoCountry    String?
  userAgent     String?
  pageViewCount Int           @default(0)
  firstSeenAt   DateTime      @default(now())
  lastSeenAt    DateTime      @default(now())

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events AnalyticsEvent[]

  @@index([tenantId, firstSeenAt, visitorId])
  @@index([tenantId, lastSeenAt])
  @@index([tenantId, trafficSource, firstSeenAt])
  @@index([tenantId, deviceType, firstSeenAt])
  @@map("visitor_sessions")
}

/// Um evento do funil de conversão. Tabela de altíssimo volume de escrita (dispara
/// a cada página vista) — de propósito sem FK em `productId`/`orderId`: excluir um
/// produto ou pedido nunca pode travar, nem precisar reescrever, histórico de
/// analytics. Resolvido com busca em lote na leitura (mesmo padrão do "Produto
/// removido" em `report-service.ts`).
model AnalyticsEvent {
  id          String             @id @default(cuid())
  tenantId    String
  sessionId   String
  type        AnalyticsEventType
  path        String?
  productId   String?
  orderId     String?
  /// Se este evento é do produto que é a Oferta Relâmpago do dia — calculado no
  /// servidor (nunca confiado do cliente) contra `flashDealSchedule` no momento
  /// do evento. Existe desde já porque esse fato é irrecuperável depois que o
  /// dia passa (o dia seguinte tem outra oferta).
  isFlashDeal Boolean            @default(false)
  createdAt   DateTime           @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, type, createdAt])
  @@index([sessionId, type])
  @@map("analytics_events")
}

// ---------------------------------------------------------------------------
// Fase 9 — Central de Atendimento WhatsApp
// ---------------------------------------------------------------------------

enum WhatsAppIntegrationStatus {
  /// Credenciais salvas, ainda não confirmadas por um envio/webhook bem-sucedido.
  PENDING
  ACTIVE
  /// Última tentativa de uso falhou (ver `lastErrorMessage`).
  ERROR
  /// Desligado manualmente pelo lojista, sem apagar a configuração.
  DISABLED
}

/// Uma linha por tenant (1:1). Não existe até o lojista configurar a integração —
/// a ausência da linha já significa "não configurado", sem precisar de um status
/// à parte. O segredo do App da Meta e o verify token do webhook são globais
/// (uma única App/callback URL para todos os tenants — ver `WHATSAPP_APP_SECRET`
/// e `WHATSAPP_WEBHOOK_VERIFY_TOKEN`), só o número/token de cada loja mora aqui.
model WhatsAppIntegration {
  id                 String                    @id @default(cuid())
  tenantId           String                    @unique
  /// ID do número de telefone na Graph API — usado para resolver o tenant a
  /// partir do payload do webhook (globalmente único na Meta).
  phoneNumberId      String                    @unique
  wabaId             String
  displayPhoneNumber String?
  /// Cifrado com AES-256-GCM (ver `token-crypto.ts`) — nunca gravado em texto puro.
  accessToken        String
  status             WhatsAppIntegrationStatus @default(PENDING)
  lastErrorMessage   String?
  connectedAt        DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("whatsapp_integrations")
}

/// Identidade do número de WhatsApp que fala com a loja. Estável ao longo do
/// tempo, diferente de `WhatsAppConversation` (o atendimento em si, que pode
/// ser fechado e reaberto várias vezes com o mesmo contato).
model WhatsAppContact {
  id          String   @id @default(cuid())
  tenantId    String
  /// Formato E.164 (ex.: "5511999998888"), sem "+". Normalizado na Fase 2,
  /// quando o número chega pela primeira vez via webhook.
  phoneE164   String
  /// Nome de perfil informado pelo WhatsApp — não é confiável para exibição
  /// oficial, é só o que a Meta manda (pode vir vazio ou qualquer coisa).
  profileName String?
  customerId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversations WhatsAppConversation[]

  @@unique([tenantId, phoneE164])
  @@index([tenantId, customerId])
  @@map("whatsapp_contacts")
}

enum WhatsAppConversationStatus {
  OPEN
  /// "Arquivada" — pode ser reaberta; não é exclusão.
  CLOSED
}

model WhatsAppConversation {
  id                 String                     @id @default(cuid())
  tenantId           String
  contactId          String
  status             WhatsAppConversationStatus @default(OPEN)
  queueId            String?
  assignedUserId     String?
  /// Desnormalizado a partir da última `WhatsAppMessage`, para a lista de
  /// conversas não precisar de subquery a cada render (mesmo raciocínio de
  /// `Product.avgRating`).
  lastMessageAt      DateTime?
  lastMessagePreview String?
  unreadCount        Int                        @default(0)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      WhatsAppContact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  queue        WhatsAppQueue?            @relation(fields: [queueId], references: [id], onDelete: SetNull)
  assignedUser User?                     @relation("WhatsAppConversationAssignedTo", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages     WhatsAppMessage[]
  tags         WhatsAppConversationTag[]

  @@index([tenantId, status, lastMessageAt])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, queueId])
  @@map("whatsapp_conversations")
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
  TEMPLATE
  INTERACTIVE
  /// Qualquer tipo que a Meta mande e o sistema ainda não saiba interpretar —
  /// o processamento nunca falha por isso, só cai aqui.
  UNKNOWN
}

enum WhatsAppMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  /// Estado de toda mensagem INBOUND assim que persistida.
  RECEIVED
}

model WhatsAppMessage {
  id             String                   @id @default(cuid())
  tenantId       String
  conversationId String
  direction      WhatsAppMessageDirection
  /// `wamid` da Meta. Chave de idempotência do webhook (Fase 2) — evita
  /// gravar a mesma mensagem duas vezes num reenvio.
  externalId     String?
  type           WhatsAppMessageType
  textBody       String?
  mediaUrl       String?
  mediaMimeType  String?
  status         WhatsAppMessageStatus    @default(PENDING)
  errorMessage   String?
  /// Nulo em mensagens INBOUND e em qualquer automação futura — uma sugestão
  /// de IA só vira mensagem quando um atendente revisa e aprova (nunca envia
  /// sozinha), então toda linha OUTBOUND sempre tem um `senderUserId` humano.
  senderUserId   String?
  createdAt      DateTime                 @default(now())

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser   User?                @relation("WhatsAppMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, externalId])
  @@index([tenantId, conversationId, createdAt])
  @@map("whatsapp_messages")
}

model WhatsAppQueue {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations WhatsAppConversation[]

  @@unique([tenantId, name])
  @@map("whatsapp_queues")
}

model WhatsAppTag {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  color     String?
  createdAt DateTime @default(now())

  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations WhatsAppConversationTag[]

  @@unique([tenantId, name])
  @@map("whatsapp_tags")
}

/// Tabela de junção conversa↔etiqueta (muitos-para-muitos).
model WhatsAppConversationTag {
  conversationId String
  tagId          String
  createdAt      DateTime @default(now())

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          WhatsAppTag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@map("whatsapp_conversation_tags")
}

model WhatsAppQuickReply {
  id        String   @id @default(cuid())
  tenantId  String
  /// Atalho digitado no chat (ex.: "pix"), sem a barra "/".
  shortcut  String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, shortcut])
  @@map("whatsapp_quick_replies")
}
